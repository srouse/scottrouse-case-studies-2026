PORTFOLIO_PASSWORD=change-me
SESSION_COOKIE_NAME=portfolio_session

# Shareable unlock (same password): https://your-domain.com/?code=<PORTFOLIO_PASSWORD>
# (Home hands off to /auth/unlock, which sets the session cookie and redirects to /work.)

# Optional: bump when you need a new Next.js build ID (helps bust CDN/cache for static assets after `next build`).
# CACHE_REVISION=2
